# =============================================================================
#  Configurazione della build — modifica qui, poi lancia build.sh
#  (formato shell: VARIABILE="valore", niente spazi attorno a "=")
# =============================================================================

# --- Identità del sistema ----------------------------------------------------
# Nome mostrato ovunque: interfaccia web, avvio, console, GRUB.
NIDO_NAME="RNFADS"
# Versione della build (finisce nel nome della ISO).
NIDO_VERSION="1.2.3"
# Nome host proposto dall'installer (si può cambiare durante l'installazione).
NIDO_HOSTNAME="rnfads"
# Scritta del marchio, pezzi separati da "|": dispari scuri in Orbitron, pari con la sfumatura in JetBrains Mono
# (vuota = automatica dal nome)
NIDO_WORDMARK="R|N|F|A|D|S"
# Sito del progetto (facoltativo, mostrato in "Informazioni e licenze")
NIDO_PROJECT_URL=""
# Aggiornamenti online: sito con i manifesti firmati, es. una cartella del PC servita in rete
# (http://192.168.1.10:8000) o GitHub Pages. Si può impostare anche dopo, da Impostazioni > Aggiornamenti.
# Vuoto = aggiornamento online spento (resta il caricamento manuale del .deb).
NIDO_UPDATE_URL=""

# --- Donazioni (pagina "Sostieni il progetto") -------------------------------
# Indirizzi https:// completi; quelli vuoti non vengono mostrati.
NIDO_DONATE_PAYPAL=""
NIDO_DONATE_KOFI=""
NIDO_DONATE_GITHUB=""
NIDO_DONATE_LIBERAPAY=""

# --- Aspetto -------------------------------------------------------------------
# Colore principale (#rrggbb) e font (non più usati dall'interfaccia nuova, tenuti per compatibilità con build.sh).
NIDO_ACCENT="#7c3aed"
NIDO_FONT="Inter"

# --- Lingua, tastiera, fuso orario -------------------------------------------
NIDO_LOCALE="it_IT.UTF-8"
NIDO_KEYMAP="it"
NIDO_TIMEZONE="Europe/Rome"

# --- Ubuntu ---------------------------------------------------------------------
# resolute = Ubuntu 26.04 LTS (supporto fino al 2031). Per la 26.10: "stonking".
UBUNTU_SUITE="resolute"
UBUNTU_MIRROR="http://archive.ubuntu.com/ubuntu"
UBUNTU_SECURITY="http://security.ubuntu.com/ubuntu"

# --- App ---------------------------------------------------------------------------
# Le fonti delle app (Big Bear, LinuxServer, CoolStore; CasaOS, ZimaOS e Unraid tolte il 31/10/2026)
# sono in nidopanel/catalog.py e si cambiano anche da Impostazioni -> App store.
# Nella ISO non c'è nessun catalogo: si scarica dai siti degli autori al primo avvio.
